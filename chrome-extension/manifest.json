{
  "manifest_version": 3,
  "name": "OTT RAG Chatbot",
  "version": "1.0",
  "description": "Expert OTT support via RAG Chatbot",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open OTT Chat"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}